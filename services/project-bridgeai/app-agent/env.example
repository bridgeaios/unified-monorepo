# Environment Variables for App Agent
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# OpenAI/Swarm Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Database (if needed)
DATABASE_URL=postgresql://user:password@localhost:5432/appagent

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:1234

# Logging
LOG_LEVEL=info
